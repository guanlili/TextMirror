# ============================================================
# TextMirror 后端配置文件模板
# 使用方法：复制为 .env 即可开始本地开发
# 生产部署：复制为 .env.production 并修改实际值
# ============================================================

# 应用基础配置
# 生成随机密钥：openssl rand -hex 32（Mac/Linux）或 python -c "import secrets;print(secrets.token_hex(32))"
# 生产环境务必替换默认密钥，否则 API Key 加密与 JWT 签发可被伪造
APP_NAME=TextMirror
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=请替换为随机安全密钥-建议32位以上
API_PREFIX=/api/v1

# JWT配置
JWT_SECRET_KEY=请替换为JWT随机安全密钥-建议32位以上
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# PostgreSQL数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=textmirror
DB_USER=postgres
DB_PASSWORD=your-db-password
DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@localhost:5432/textmirror

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# 大模型配置：无需在 .env 配置，启动后在管理后台「大模型配置」中添加（支持 15 家供应商）

# 文件存储配置
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20

# 游客限流配置
GUEST_DAILY_LIMIT=2000
GUEST_TEXT_MAX_LENGTH=100000

# 登录失败锁定（连续失败 N 次锁定 M 秒，按 工号+IP 维度）
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900

# CORS配置（多个域名用JSON数组格式）
CORS_ORIGINS=["http://localhost:3022","http://localhost:3000","http://127.0.0.1:3022"]

# 用户默认密码（管理员重置密码、飞书首次登录自动创建用户时使用）
DEFAULT_USER_PASSWORD=admin123

# ============================================================
# 以下为可选配置，不配置不影响核心功能
# ============================================================

# 飞书对接配置（可选，用于飞书扫码登录/SSO）
# FEISHU_APP_ID=your-feishu-app-id
# FEISHU_APP_SECRET=your-feishu-app-secret
# FEISHU_REDIRECT_URI=https://your-domain.com/login
# FEISHU_ENABLED=false
