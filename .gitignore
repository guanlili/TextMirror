# ============================================================
# TextMirror .gitignore
# ============================================================

# ---- 环境配置（含敏感信息，勿提交） ----
.env
.env.*
!.env.example
!.env.*.example
backend/.env
backend/.env.production
backend/.env.docker

# ---- SSL 证书 ----
frontend/ssl/
nginx/

# ---- Python ----
backend/venv/
.venv/
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
*.egg

# ---- Node.js ----
frontend/node_modules/
frontend/dist/

# ---- Docker 构建产物 ----
docker-images/*.tar

# ---- 生产数据（compose 挂载的 PG/Redis 数据目录）----
/data/

# ---- 新仓库初始化时保留的本地 Git 历史备份 ----
.git-backups/

# ---- 上传文件 ----
backend/uploads/*
!backend/uploads/.gitkeep

# ---- IDE ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- OS ----
.DS_Store
Thumbs.db
Desktop.ini

# ---- 日志 ----
*.log
logs/

# ---- 内部开发文档（不随开源发布） ----
修改问题反馈记录.md
待修复问题汇总.md
服务器IP封禁问题备忘.md
飞书对接流程及配置及开发文档.md
backend/celerybeat-schedule*
